<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OfferLens.Views"
             xmlns:vm="clr-namespace:OfferLens.ViewModels"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="960"
             x:Class="OfferLens.Views.HelpGuide"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Text="Help / FAQ" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="10" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock Text="What is the point of this app?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    This app is designed to help you quickly evaluate driving gig offers by calculating the dollars per mile and dollars per hour for each offer. It provides an overlay on your screen when you receive an offer, allowing you to make informed decisions about which gigs are worth accepting. I created this app because I sometimes drive for Doordash and was looking for a better way to gauge the value of each offer I receive.    
                </TextBlock>

                <TextBlock Text="How to use this app?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    Use the large round button to turn the overlay on or off. When the overlay is on, you can see the calculated dollars per mile and dollars per hour for each offer you receive. This will help you quickly assess the value of each gig without having to do the math yourself. In the textboxes, enter your preferred minimum dollars per mile and dollars per hour. You can optionally also enable the "great" checkbox to specify orders that you consider to be great offers. The app will then highlight these offers in the overlay, making it easier for you to identify the best offers.
                </TextBlock>

                <TextBlock Text="What is a good rule of thumb for defining 'good' or 'great' offers?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    For "good", choose the minimum value where you'll make enough profit if the dropoff location is in a spot where you're likely to get another order fairly quickly. For "great", it's recommended to choose the minimum value you'd need to make a profit even if you have to drive all the way back after the dropoff.
                </TextBlock>                

                <TextBlock Text="What driving apps does OfferLens work with?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    At the moment, this app works with the Doordash Dasher app. If OfferLens becomes more popular, it may be expanded to work with other driving gig apps in the future. Because I am a Dasher myself, I am most familiar with the Dasher app and can more easily test any updates myself. 
                </TextBlock>

                <TextBlock Text="Does OfferLens work outside the United States?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    Currently, OfferLens only supports US DoorDash offers formatted in US Dollars ($) and miles (mi). Support for international currencies and metric units (kilometers) may be added in future updates based on driver demand.
                </TextBlock>

                <TextBlock Text="Something isn't working right. How do I report an issue?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    <Run Text="If you encounter any issues with the app, please report them to me via email at "/>
                    <InlineUIContainer>
                        <HyperlinkButton Content="OfferLensSupport@gmail.com" NavigateUri="mailto:OfferLensSupport@gmail.com" Padding="0" Margin="0,-5"/>
                    </InlineUIContainer> 
                    
                    <Run Text=". If the overlays are not displaying correctly, please attach a screenshot of the screen which shows the issue so I can diagnose the problem and provide a fix. I will do my best to respond to all emails in a timely manner."/>
                </TextBlock>

                <TextBlock Text="Is any personal data collected by this app?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    No, this app does not collect any personal data. It only reads the offer details from your Dasher app in real-time to calculate the dollars per mile and dollars per hour for each offer. The app does not store or transmit any of this data.
                </TextBlock>

                <TextBlock Text="How to disable the accessibility shortcut, or the app permissions?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    If you activated the accessibility shortcut (the small semitransparent icon on your screen), you can disable it by clicking the button below. You can also use this button to revoke the app's accessibility permission entirely, which will disable the app.
                </TextBlock>

                <Button Content="Open Accessibility Settings" Margin="10" Command="{Binding OpenSettingsCommand}" FontSize="20"/>

                <TextBlock Text="How can I support the development of this app?" FontSize="24" FontWeight="Bold" Margin="10" TextWrapping="Wrap"/>

                <TextBlock TextWrapping="Wrap" Margin="10" TextAlignment="Justify" FontSize="16">
                    This app is entirely free to use, but if you would like to show your support for the development of this app, you can do so by sending a donation to me via PayPal or Cash App:
                </TextBlock>

                <Grid ColumnDefinitions="*, *">
                    <Button Margin="10" FontSize="16" CornerRadius="20" Background="#FFD140" HorizontalAlignment="Center" Command="{Binding DonatePaypalCommand}">
                        <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center">
                            <Viewbox Width="40" Height="40">
                                <Canvas Width="48" Height="48">
                                    <!-- Dark Blue Path -->
                                    <Path Fill="#002991" 
                                          Data="F1 M38.914 13.35c0 5.574-5.144 12.15-12.927 12.15H18.49l-.368 2.322L16.373 39H7.056l5.605-36h15.095c5.083 0 9.082 2.833 10.555 6.77a9.687 9.687 0 0 1 .603 3.58z" />
        
                                    <!-- Light Blue Path -->
                                    <Path Fill="#60CDFF" 
                                          Data="F1 M44.284 23.7A12.894 12.894 0 0 1 31.53 34.5h-5.206L24.157 48H14.89l1.483-9 1.75-11.178.367-2.322h7.497c7.773 0 12.927-6.576 12.927-12.15 3.825 1.974 6.055 5.963 5.37 10.35z" />
        
                                    <!-- Medium Blue Path -->
                                    <Path Fill="#008CFF" 
                                          Data="F1 M38.914 13.35C37.31 12.511 35.365 12 33.248 12h-12.64L18.49 25.5h7.497c7.773 0 12.927-6.576 12.927-12.15z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="PayPal" VerticalAlignment="Center" Margin="10,0" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="Black"/>
                        </Grid>
                    </Button>
                    <Button Margin="10" FontSize="16" Grid.Column="1" CornerRadius="20" Background="#00e013" HorizontalAlignment="Center" Command="{Binding DonateCashAppCommand}">
                        <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center">
                            <Viewbox Width="40" Height="40">
                                <Canvas Width="210" Height="210">
                                    <!-- The Green Rounded Rectangle -->
                                    <Rectangle Canvas.Left="25" Canvas.Top="25" 
                                               Width="150" Height="150" 
                                               RadiusX="7.81424" RadiusY="7.81424" 
                                               Fill="#00e013" />
        
                                    <!-- The Black Cash App Path -->
                                    <Path Fill="#000000" 
                                          Data="F0 M206.398,30.286c-4.502-12.394-14.307-22.189-26.713-26.687C168.48,0,158.075,0,136.865,0h-63.63 c-21.11,0-31.615,0-42.92,3.498C17.909,7.996,8.104,17.792,3.602,30.186C0,41.58,0,52.075,0,73.165v63.57 c0,21.19,0,31.585,3.502,42.98c4.502,12.394,14.307,22.189,26.713,26.687C41.62,210,52.125,210,73.135,210h63.63 c21.11,0,31.615,0,42.92-3.598c12.406-4.498,22.211-14.293,26.713-26.687C210,168.32,210,157.825,210,136.735v-63.47 C210,52.175,210,41.68,206.398,30.286z M151.472,71.866l-12.106,9.895c-1.101,0.9-2.601,0.7-3.402-0.4 c-6.203-7.596-15.807-11.894-26.312-11.894c-11.706,0-19.009,5.098-19.009,12.294c-0.2,6.097,5.503,9.196,23.011,12.994 c22.111,4.698,32.215,13.893,32.215,29.386c0,19.391-15.808,33.684-40.519,35.283l-2.401,11.495 c-0.2,1.099-1.201,1.899-2.401,1.899H81.539c-1.601,0-2.701-1.499-2.401-2.999l3.001-12.794 c-12.206-3.498-22.111-10.295-27.813-18.591c-0.7-1.099-0.5-2.499,0.5-3.298l13.206-10.395c1.101-0.9,2.701-0.6,3.502,0.5 c7.003,9.795,17.808,15.593,30.815,15.593c11.706,0,20.51-5.697,20.51-13.893c0-6.297-4.402-9.196-19.309-12.294 c-25.412-5.497-35.517-14.793-35.517-30.286c0-17.991,15.107-31.485,37.918-33.284l2.501-11.894c0.2-1.099,1.201-1.899,2.401-1.899 h18.709c1.501,0,2.701,1.399,2.401,2.899l-2.901,13.294c9.805,2.999,17.808,8.396,22.811,15.093 C152.673,69.567,152.473,71.066,151.472,71.866z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Cash App" VerticalAlignment="Center" Margin="10,0" Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="Black"/>
                        </Grid>
                    </Button>
                </Grid>

                
                
            </StackPanel>
        </ScrollViewer>

        <Button Content="Close" Margin="10" FontSize="24" FontWeight="Bold" Padding="25,10" HorizontalAlignment="Center" Grid.Row="2" Command="{Binding CloseHelpPageCommand}"/>
    </Grid>

    
    
</UserControl>
